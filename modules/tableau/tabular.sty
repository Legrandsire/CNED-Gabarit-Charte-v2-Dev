%%%%%%
%% Tableaux chartés et redéfinition de l'environnement natif « tabular ».
%%
%% Depuis la mise à la charte des environnements standards, un tableau saisi
%% via l'éditeur visuel Overleaf (\begin{tabular}{|l|l|} ... \hline ...) est
%% charté automatiquement : colonnes converties en colonnes chartées de
%% largeurs égales, première ligne habillée en cartouches d'en-tête, filets
%% colorés, police condensée. Aucune commande maison n'est nécessaire.
%%
%% Arguments (tous optionnels, positionnels, avec valeur par défaut) :
%%   #1 = header     : primary (défaut) | secondary | none
%%                     couleur des cartouches d'en-tête ; none = pas d'en-tête
%%                     (toutes les lignes sont alors des lignes de corps)
%%   #2 = border     : secondary (défaut) | primary | none
%%                     couleur des filets ; none = aucun filet
%%   #3 = width      : auto (défaut, pleine largeur, colonnes égales)
%%                     | ratio global de la largeur de ligne, ex. 0.5
%%                       (1 équivaut à auto ; colonnes égales)
%%                     | liste de fractions par colonne séparées par des
%%                       virgules, ex. 0.3,0.5 (autant de valeurs que de
%%                       colonnes)
%%   #4 = align      : left (défaut) | center
%%                     alignement du contenu des cellules (colonnes T ou C)
%%   #5 = rowspacing : tight | normal (défaut) | loose, OU facteur libre
%%                     (ex. 1.6) ; hauteur des lignes (\arraystretch)
%%   #6 = padding    : tight | normal (défaut) | loose, OU valeur libre
%%                     (ex. 6pt) ; marge intérieure horizontale des cellules
%%                     (colonnes alignées à gauche uniquement)
%%   #7 = stripes    : none (défaut) | alternate (background1 / background2)
%%                     | paire <impaires>,<paires> parmi background1,
%%                       background2, white, gray (gris très clair), ex.
%%                       white,background1 ; une seule valeur colore les
%%                       lignes impaires (paires en blanc). Fonds appliqués
%%                       aux lignes de corps uniquement.
%%
%% Exemples :
%%   \begin{tabular}{|l|l|}                          -> tableau charté (défauts)
%%   \begin{tabular}[secondary][primary]{|l|l|}      -> couleurs inversées
%%   \begin{tabular}[primary][secondary][0.3,0.5]{|l|l|} -> largeurs sur mesure
%%
%% Deux modes de fonctionnement :
%% - mode SIMPLE : le descripteur ne contient que l, c, r et « | » (sortie
%%   type éditeur visuel). Le tableau est reconstruit entièrement charté :
%%   les \hline de la source sont normalisés (un filet sous chaque ligne de
%%   corps), la première ligne devient la ligne de cartouches.
%% - mode EXPERT : le descripteur contient autre chose (T{...}, C{...},
%%   p{...}, @{...}...). Le contenu est composé TEL QUEL ; seuls la police,
%%   la couleur des filets et les réglages d'espacement s'appliquent. Les
%%   tableaux historiques (colonnes T{} + \cartoucheun + \multicolumn)
%%   restent donc strictement inchangés.
%%
%% L'environnement « longtable » (tableaux longs, coupés en fin de page) est
%% redéfini de la même façon et avec les mêmes arguments ; en mode simple,
%% la ligne de cartouches est répétée en tête de chaque page.
%%
%% Limites (mode simple) :
%% - pas de tableau imbriqué dans une cellule : utiliser oldtabular pour le
%%   tableau intérieur (portes de sortie : oldtabular / oldlongtable, les
%%   environnements natifs conservés tels quels) ;
%% - dans une cellule, un retour à la ligne s'écrit \newline (jamais \\, qui
%%   termine la ligne du tableau) ;
%% - l'argument optionnel natif de position ([t]/[b]) n'existe plus : le
%%   premier crochet est désormais la couleur d'en-tête ;
%% - ne pas utiliser tabularx avec le gabarit.
%%
%% \setresolvedcolor est défini dans modules/listes/itemize.sty.

%%%%%% Réglages globaux
\setlength{\tabcolsep}{2pt}       %% Espacement des étiquettes
\renewcommand{\arraystretch}{1.4} %% Espacement vertical dans les tableaux
\newcommand{\setSpaceTabLength}{10pt} %% Marge intérieure horizontale (colonnes T)

\usepackage{array}
\usepackage{xparse}
\RequirePackage{longtable}

%% Un tableau légendé (environnement table, posé par l'éditeur visuel) reste
%% à l'endroit de sa saisie : placement « ici, exactement » par défaut.
%% Un placement explicite (\begin{table}[t]...) garde la main.
\floatplacement{table}{H}

%% Gris très clair des fonds de lignes (mot-clé « gray » de l'argument stripes)
\definecolor{grisTableau}{HTML}{F2F2F2}

%%%%%% Colonnes chartées (utilisables aussi à la main, mode expert)
\newcolumntype{T}[1]{>{\hspace{\setSpaceTabLength}\robotoCondensed\raggedright\arraybackslash}p{#1}<{\hspace{\setSpaceTabLength}}}
\newcolumntype{C}[1]{>{\robotoCondensed\centering\arraybackslash}p{#1}}

%%%%%% Sauvegarde des environnements natifs (portes de sortie)
\let\oldtabular\tabular
\let\endoldtabular\endtabular
\let\oldlongtable\longtable
\let\endoldlongtable\endlongtable

%%%%%% Résolution de la hauteur de ligne (facteur \arraystretch)
\newcommand{\setresolvedstretch}[1]{%
  \def\resolvedstretch{#1}%
  \ifstrequal{#1}{tight}{\def\resolvedstretch{1.1}}{}%
  \ifstrequal{#1}{normal}{\def\resolvedstretch{1.4}}{}%
  \ifstrequal{#1}{loose}{\def\resolvedstretch{1.8}}{}%
}

%%%%%% Résolution de la marge intérieure des cellules
\newcommand{\setresolvedtabpad}[1]{%
  \def\resolvedtabpad{#1}%
  \ifstrequal{#1}{tight}{\def\resolvedtabpad{4pt}}{}%
  \ifstrequal{#1}{normal}{\def\resolvedtabpad{10pt}}{}%
  \ifstrequal{#1}{loose}{\def\resolvedtabpad{16pt}}{}%
}

%%%%%% Cartouche d'en-tête de tableau, paramétré en couleur.
%% \cartoucheTableau[primary|secondary]{titre}
%% (fusion des anciens \cartoucheun / \cartouchedeux, conservés ci-dessous
%% comme raccourcis pour les documents existants)
\NewDocumentCommand{\cartoucheTableau}{ O{primary} m }{%
\setresolvedcolor{#1}%
\begin{tikzpicture}[baseline=(main.base), xshift=0pt]
\node[
    rectangle,
    text width=\linewidth,
    fill=none,
    text=white,
    inner xsep=2pt,
    inner ysep=5pt,
    outer sep=0pt,
    minimum height=20pt
] (main) {%
  \parbox[b]{\linewidth}{\centering\bfseries #2}%
};

\begin{pgfonlayer}{background}
  \def\r{8pt}

  \coordinate (SW) at (main.south west);
  \coordinate (SE) at (main.south east);
  \coordinate (NE) at (main.north east);
  \coordinate (NW) at (main.north west);

  \path[fill=\resolvedcolor]
    (SW) --
    ([xshift=-\r]SE) arc (270:360:\r)
    --
    (NE) --
    ([xshift=\r]NW) arc (90:180:\r)
    --
    (SW) -- cycle;
\end{pgfonlayer}
\end{tikzpicture}%
}

\newcommand{\cartoucheun}[1]{\cartoucheTableau[primary]{#1}}
\newcommand{\cartouchedeux}[1]{\cartoucheTableau[secondary]{#1}}

%%%%%% Mécanique interne de reconstruction chartée
\ExplSyntaxOn

\int_new:N \l__cnedtab_ncols_int
\int_new:N \l__cnedtab_tmp_int
\bool_new:N \l__cnedtab_simple_bool
\bool_new:N \l__cnedtab_border_bool
\bool_new:N \l__cnedtab_header_bool
\bool_new:N \l__cnedtab_stripes_bool
\tl_new:N \l__cnedtab_colspec_tl
\tl_new:N \l__cnedtab_coltype_tl
\tl_new:N \l__cnedtab_headercolor_tl
\tl_new:N \l__cnedtab_headerrow_tl
\tl_new:N \l__cnedtab_bodyrows_tl
\tl_new:N \l__cnedtab_body_tl
\tl_new:N \l__cnedtab_firstrow_tl
\seq_new:N \l__cnedtab_rows_seq
\seq_new:N \l__cnedtab_cells_seq
\clist_new:N \l__cnedtab_widths_clist
\clist_new:N \l__cnedtab_userw_clist
\clist_new:N \l__cnedtab_pair_clist
\tl_new:N \l__cnedtab_ratio_tl
\tl_new:N \l__cnedtab_oddbg_tl
\tl_new:N \l__cnedtab_evenbg_tl
\dim_new:N \l__cnedtab_colwidth_dim

\cs_generate_variant:Nn \seq_set_split:Nnn { NnV }

\msg_new:nnn { cnedify } { widths-mismatch }
  { Tableau~:~#1~largeur(s)~[width]~fournie(s)~pour~#2~colonne(s). }
\msg_new:nnn { cnedify } { cells-mismatch }
  { Tableau~:~la~ligne~d'en-tete~contient~#1~cellule(s)~pour~#2~colonne(s). }

%% Analyse du descripteur : mode simple ssi uniquement l, c, r et |
%% (compte les colonnes au passage)
\cs_new_protected:Nn \__cnedtab_analyse_spec:n
{
  \bool_set_true:N \l__cnedtab_simple_bool
  \int_zero:N \l__cnedtab_ncols_int
  \tl_map_inline:nn {#1}
  {
    \str_case:nnF {##1}
    {
      { l } { \int_incr:N \l__cnedtab_ncols_int }
      { c } { \int_incr:N \l__cnedtab_ncols_int }
      { r } { \int_incr:N \l__cnedtab_ncols_int }
      { | } { }
    }
    {
      \bool_set_false:N \l__cnedtab_simple_bool
      \tl_map_break:
    }
  }
  \int_compare:nNnT { \l__cnedtab_ncols_int } = { 0 }
    { \bool_set_false:N \l__cnedtab_simple_bool }
}

%% Application des options communes
%% #1 = header, #2 = border, #3 = rowspacing, #4 = padding, #5 = stripes
\cs_new_protected:Nn \__cnedtab_options:nnnnn
{
  \str_if_eq:nnTF {#1} { none }
    { \bool_set_false:N \l__cnedtab_header_bool }
    {
      \bool_set_true:N \l__cnedtab_header_bool
      \tl_set:Nn \l__cnedtab_headercolor_tl {#1}
    }
  \str_if_eq:nnTF {#2} { none }
    {
      \bool_set_false:N \l__cnedtab_border_bool
      \setlength { \arrayrulewidth } { 0pt }
    }
    {
      \bool_set_true:N \l__cnedtab_border_bool
      \setresolvedcolor {#2}
      % expansion avant stockage : colortbl retient les tokens pour toute
      % la table, \resolvedcolor peut changer entre-temps (cartouches...)
      \exp_args:No \arrayrulecolor { \resolvedcolor }
    }
  \setresolvedstretch {#3}
  \edef \arraystretch { \resolvedstretch }
  \setresolvedtabpad {#4}
  \edef \setSpaceTabLength { \resolvedtabpad }
  % fonds des lignes de corps : none | alternate | paire <impaires>,<paires>
  \str_case:nnF {#5}
  {
    { none }
    { \bool_set_false:N \l__cnedtab_stripes_bool }
    { alternate }
    {
      \bool_set_true:N \l__cnedtab_stripes_bool
      \tl_set:Nn \l__cnedtab_oddbg_tl { background1 }
      \tl_set:Nn \l__cnedtab_evenbg_tl { background2 }
    }
  }
  {
    \bool_set_true:N \l__cnedtab_stripes_bool
    \clist_set:Nn \l__cnedtab_pair_clist {#5}
    \tl_set:Nx \l__cnedtab_oddbg_tl
      { \clist_item:Nn \l__cnedtab_pair_clist { 1 } }
    \int_compare:nNnTF { \clist_count:N \l__cnedtab_pair_clist } < { 2 }
      { \tl_set:Nn \l__cnedtab_evenbg_tl { white } }
      {
        \tl_set:Nx \l__cnedtab_evenbg_tl
          { \clist_item:Nn \l__cnedtab_pair_clist { 2 } }
      }
    \__cnedtab_map_rowbg:N \l__cnedtab_oddbg_tl
    \__cnedtab_map_rowbg:N \l__cnedtab_evenbg_tl
  }
}

%% Mot-clé « gray » : gris très clair de la charte tableau
\cs_new_protected:Nn \__cnedtab_map_rowbg:N
{
  \str_if_eq:VnT #1 { gray } { \tl_set:Nn #1 { grisTableau } }
}

%% Construction de la ligne de cartouches à partir de la première ligne
%% #1 = contenu de la première ligne (cellules séparées par &)
\cs_new_protected:Nn \__cnedtab_build_header:n
{
  \tl_if_in:nnTF {#1} { \multicolumn }
  {
    % ligne déjà façonnée à la main : on la laisse telle quelle
    \tl_set:Nn \l__cnedtab_headerrow_tl { #1 \\ }
  }
  {
    \seq_set_split:Nnn \l__cnedtab_cells_seq { & } {#1}
    \int_compare:nNnF
      { \seq_count:N \l__cnedtab_cells_seq } = { \l__cnedtab_ncols_int }
      {
        \msg_warning:nnxx { cnedify } { cells-mismatch }
          { \seq_count:N \l__cnedtab_cells_seq }
          { \int_use:N \l__cnedtab_ncols_int }
      }
    \int_zero:N \l__cnedtab_tmp_int
    \seq_map_inline:Nn \l__cnedtab_cells_seq
    {
      \int_incr:N \l__cnedtab_tmp_int
      \int_compare:nNnT { \l__cnedtab_tmp_int } > { 1 }
        { \tl_put_right:Nn \l__cnedtab_headerrow_tl { & } }
      \tl_put_right:Nx \l__cnedtab_headerrow_tl
      {
        \exp_not:N \multicolumn { 1 }
        { p { \clist_item:Nn \l__cnedtab_widths_clist
              { \int_min:nn { \l__cnedtab_tmp_int } { \l__cnedtab_ncols_int } } } }
        { \exp_not:N \cartoucheTableau
          [ \exp_not:V \l__cnedtab_headercolor_tl ]
          { \exp_not:n {##1} } }
      }
    }
    \tl_put_right:Nn \l__cnedtab_headerrow_tl { \\ }
  }
}

%% Construction des lignes de corps (filet sous chaque ligne, fonds alternés)
\cs_new_protected:Nn \__cnedtab_build_body:
{
  \int_zero:N \l__cnedtab_tmp_int
  \seq_map_inline:Nn \l__cnedtab_rows_seq
  {
    \int_incr:N \l__cnedtab_tmp_int
    \bool_if:NT \l__cnedtab_stripes_bool
    {
      \int_if_odd:nTF { \l__cnedtab_tmp_int }
        {
          \tl_put_right:Nx \l__cnedtab_bodyrows_tl
            { \exp_not:N \rowcolor { \tl_use:N \l__cnedtab_oddbg_tl } }
        }
        {
          \tl_put_right:Nx \l__cnedtab_bodyrows_tl
            { \exp_not:N \rowcolor { \tl_use:N \l__cnedtab_evenbg_tl } }
        }
    }
    \tl_put_right:Nn \l__cnedtab_bodyrows_tl { ##1 \\ }
    \bool_if:NT \l__cnedtab_border_bool
      { \tl_put_right:Nn \l__cnedtab_bodyrows_tl { \hline } }
  }
}

%% Traitement complet : options, analyse, reconstruction (ou passage tel quel)
%% #1..#7 = les sept options, #8 = descripteur de colonnes, #9 = corps
\cs_new_protected:Nn \__cnedtab_process:nnnnnnnnn
{
  \tl_clear:N \l__cnedtab_colspec_tl
  \tl_clear:N \l__cnedtab_headerrow_tl
  \tl_clear:N \l__cnedtab_bodyrows_tl
  \__cnedtab_options:nnnnn {#1} {#2} {#5} {#6} {#7}
  \__cnedtab_analyse_spec:n {#8}
  \bool_if:NTF \l__cnedtab_simple_bool
  {
    % ---- largeurs de colonnes
    \clist_clear:N \l__cnedtab_widths_clist
    \str_if_eq:nnTF {#3} { auto }
    {
      \int_set:Nn \l__cnedtab_tmp_int { \l__cnedtab_ncols_int + 1 }
      \dim_set:Nn \l__cnedtab_colwidth_dim
        {
          ( \linewidth
            - \tabcolsep * 2 * \l__cnedtab_ncols_int
            - \arrayrulewidth * \l__cnedtab_tmp_int )
          / \l__cnedtab_ncols_int
        }
      \int_step_inline:nn { \l__cnedtab_ncols_int }
        {
          \clist_put_right:Nx \l__cnedtab_widths_clist
            { \dim_use:N \l__cnedtab_colwidth_dim }
        }
    }
    {
      \clist_set:Nn \l__cnedtab_userw_clist {#3}
      \int_compare:nNnTF { \clist_count:N \l__cnedtab_userw_clist } = { 1 }
      {
        % une seule valeur = ratio global : le tableau occupe
        % <ratio>\linewidth, colonnes égales
        \tl_set:Nx \l__cnedtab_ratio_tl
          { \clist_item:Nn \l__cnedtab_userw_clist { 1 } }
        \int_set:Nn \l__cnedtab_tmp_int { \l__cnedtab_ncols_int + 1 }
        \dim_set:Nn \l__cnedtab_colwidth_dim
          {
            ( \l__cnedtab_ratio_tl \linewidth
              - \tabcolsep * 2 * \l__cnedtab_ncols_int
              - \arrayrulewidth * \l__cnedtab_tmp_int )
            / \l__cnedtab_ncols_int
          }
        \int_step_inline:nn { \l__cnedtab_ncols_int }
          {
            \clist_put_right:Nx \l__cnedtab_widths_clist
              { \dim_use:N \l__cnedtab_colwidth_dim }
          }
      }
      {
        % une valeur par colonne (fractions de \linewidth)
        \clist_map_inline:Nn \l__cnedtab_userw_clist
          { \clist_put_right:Nn \l__cnedtab_widths_clist { ##1 \linewidth } }
        \int_compare:nNnF
          { \clist_count:N \l__cnedtab_widths_clist } = { \l__cnedtab_ncols_int }
          {
            \msg_error:nnxx { cnedify } { widths-mismatch }
              { \clist_count:N \l__cnedtab_widths_clist }
              { \int_use:N \l__cnedtab_ncols_int }
          }
      }
    }
    % ---- descripteur charté
    \str_if_eq:nnTF {#4} { center }
      { \tl_set:Nn \l__cnedtab_coltype_tl { C } }
      { \tl_set:Nn \l__cnedtab_coltype_tl { T } }
    \clist_map_inline:Nn \l__cnedtab_widths_clist
    {
      \bool_if:NT \l__cnedtab_border_bool
        { \tl_put_right:Nn \l__cnedtab_colspec_tl { | } }
      \tl_put_right:Nx \l__cnedtab_colspec_tl
        { \tl_use:N \l__cnedtab_coltype_tl { \exp_not:n {##1} } }
    }
    \bool_if:NT \l__cnedtab_border_bool
      { \tl_put_right:Nn \l__cnedtab_colspec_tl { | } }
    % ---- normalisation du corps : retrait des \hline, découpage des lignes
    \tl_set:Nn \l__cnedtab_body_tl {#9}
    \tl_remove_all:Nn \l__cnedtab_body_tl { \hline }
    \seq_set_split:NnV \l__cnedtab_rows_seq { \\ } \l__cnedtab_body_tl
    \seq_remove_all:Nn \l__cnedtab_rows_seq { }
    % ---- ligne d'en-tête
    \bool_if:NTF \l__cnedtab_header_bool
    {
      \seq_if_empty:NF \l__cnedtab_rows_seq
      {
        \seq_pop_left:NN \l__cnedtab_rows_seq \l__cnedtab_firstrow_tl
        \exp_args:NV \__cnedtab_build_header:n \l__cnedtab_firstrow_tl
      }
    }
    {
      % pas d'en-tête : filet supérieur si les bordures sont actives
      \bool_if:NT \l__cnedtab_border_bool
        { \tl_set:Nn \l__cnedtab_headerrow_tl { \hline } }
    }
    % ---- lignes de corps
    \__cnedtab_build_body:
  }
  {
    % ---- mode expert : descripteur et corps respectés tels quels
    \tl_set:Nn \l__cnedtab_colspec_tl {#8}
    \tl_set:Nn \l__cnedtab_bodyrows_tl {#9}
  }
}

%%%%%% Redéfinition chartée de tabular
\RenewDocumentEnvironment { tabular }
  { O{primary} O{secondary} O{auto} O{left} O{normal} O{normal} O{none} m +b }
{
  \__cnedtab_process:nnnnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} {#8} {#9}
  \robotoCondensed
  \exp_args:NV \oldtabular \l__cnedtab_colspec_tl
  \tl_use:N \l__cnedtab_headerrow_tl
  \tl_use:N \l__cnedtab_bodyrows_tl
  \endoldtabular
}
{ }

%%%%%% Redéfinition chartée de longtable (tableaux longs multi-pages)
%% Mêmes arguments que tabular ; en mode simple, la ligne de cartouches est
%% répétée en tête de chaque page. En mode expert, le corps est composé tel
%% quel (y compris \endhead et consorts si fournis).
\RenewDocumentEnvironment { longtable }
  { O{primary} O{secondary} O{auto} O{left} O{normal} O{normal} O{none} m +b }
{
  \__cnedtab_process:nnnnnnnnn {#1} {#2} {#3} {#4} {#5} {#6} {#7} {#8} {#9}
  \robotoCondensed
  \exp_args:NV \oldlongtable \l__cnedtab_colspec_tl
  \bool_if:NT \l__cnedtab_simple_bool
  {
    \tl_if_empty:NF \l__cnedtab_headerrow_tl
    {
      \tl_use:N \l__cnedtab_headerrow_tl \endfirsthead
      \tl_use:N \l__cnedtab_headerrow_tl \endhead
    }
  }
  \tl_use:N \l__cnedtab_bodyrows_tl
  \endoldlongtable
}
{ }

\ExplSyntaxOff
