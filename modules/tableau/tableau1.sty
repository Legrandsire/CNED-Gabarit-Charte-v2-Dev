%%%% Développement d'un module tableau. 
\usepackage{xparse}
\usepackage{array}
\usepackage{environ}

\newcolumntype{C}[1]{>{\robotoCondensed\centering\arraybackslash}p{#1}}

\ExplSyntaxOn

\clist_new:N \l_arky_widths_clist
\clist_new:N \l_arky_titles_clist
\tl_new:N    \l_arky_colspec_tl

% construit le préambule du tableau, ex. |C{0.1\linewidth}|C{0.2\linewidth}|C{0.15\linewidth}|
\cs_new:Nn \arky_build_colspec:n
{
  \clist_map_inline:nn {#1} { |C{##1} } |
}

% construit la ligne des cartouches
\cs_new_protected:Nn \arky_build_header:nn
{
  \clist_set:Nn \l_arky_widths_clist {#1}
  \clist_set:Nn \l_arky_titles_clist {#2}

  \int_compare:nNnF
    { \clist_count:N \l_arky_widths_clist }
    =
    { \clist_count:N \l_arky_titles_clist }
    {
      \msg_error:nnxx { arky } { mismatch }
        { \clist_count:N \l_arky_widths_clist }
        { \clist_count:N \l_arky_titles_clist }
    }

  \int_zero:N \l_tmpa_int
  \clist_map_inline:Nn \l_arky_titles_clist
  {
    \int_incr:N \l_tmpa_int
    \multicolumn{1}
      {C{\clist_item:Nn \l_arky_widths_clist {\l_tmpa_int}}}
      {\cartoucheun{##1}}
    \int_compare:nNnTF
      { \l_tmpa_int } < { \clist_count:N \l_arky_titles_clist }
      { & }
      { \\ }
  }
}

\msg_new:nnn { arky } { mismatch }
  { Le~nombre~de~largeurs~(#1)~ne~correspond~pas~au~nombre~de~titres~(#2). }

\NewEnviron{monTableau}[2]
{
  % #1 = largeurs séparées par des virgules
  % #2 = titres séparés par des virgules

  \renewcommand{\arraystretch}{1.35}
  \setlength{\extrarowheight}{2pt}
  \setlength{\tabcolsep}{0pt}

  % On développe d'abord le préambule dans une tl
  \tl_set:Ne \l_arky_colspec_tl { \arky_build_colspec:n {#1} }

  % Puis on ouvre réellement le tabular avec le préambule déjà développé
  \expandafter\begin{tabular}\expandafter{\l_arky_colspec_tl}
  \arky_build_header:nn {#1} {#2}
  \BODY
  \end{tabular}
}

\ExplSyntaxOff