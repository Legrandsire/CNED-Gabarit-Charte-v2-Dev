%%%% Cartouches pour les tableaux

\newcommand{\cartoucheun}[1]{%
\begin{tikzpicture}[baseline=(main.base), xshift=0pt]
\node[
    rectangle,
    text width=\linewidth,
    fill=none,
    text=white,
    inner xsep=2pt,
    inner ysep=5pt,
    outer sep=0pt,
    minimum height=20pt
] (main) {%
  \parbox[b]{\linewidth}{\centering\bfseries #1}%
};

\begin{pgfonlayer}{background}
  \def\padx{0pt}
  \def\pady{0pt}
  \def\r{8pt}

  \coordinate (SW) at ([xshift=-\padx,yshift=-\pady]main.south west);
  \coordinate (SE) at ([xshift= \padx,yshift=-\pady]main.south east);
  \coordinate (NE) at ([xshift= \padx,yshift= \pady]main.north east);
  \coordinate (NW) at ([xshift=-\padx,yshift= \pady]main.north west);

  \path[fill=primarycolor]
    (SW) --
    ([xshift=-\r]SE) arc (270:360:\r)
    --
    (NE) --
    ([xshift=\r]NW) arc (90:180:\r)
    --
    (SW) -- cycle;
\end{pgfonlayer}
\end{tikzpicture}%
}




