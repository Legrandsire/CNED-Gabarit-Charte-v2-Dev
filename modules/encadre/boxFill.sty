\NewEnviron{boxFill}[1][primary]{%
  \begin{center}
  \begin{tikzpicture}
    \def\r{10pt}

    % --- choix de la couleur ---
    \def\bgcolor{background1} % primary par défaut
    \ifstrequal{#1}{secondary}{%
      \def\bgcolor{background2}
    }{}

    % --- contenu ---
    \node[
      inner sep=10pt,
      text width=\dimexpr\textwidth-20pt\relax,
      anchor=north west
    ] (box) {\robotoCondensed\fontsize{10.5}{13}\selectfont\BODY};

    % --- fond ---
    \begin{pgfonlayer}{background}
      \path[fill=\bgcolor]
        (box.south west) --
        ($(box.south east)+(-\r,0)$)
          arc[start angle=270,end angle=360,radius=\r] --
        (box.north east) --
        ($(box.north west)+(\r,0)$)
          arc[start angle=90,end angle=180,radius=\r] --
        cycle;
    \end{pgfonlayer}

  \end{tikzpicture}
  \end{center}
}