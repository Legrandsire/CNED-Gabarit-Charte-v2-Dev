\NewEnviron{boxBorder}[1][primary]{%
%% Deux options : primary ou secondary
  \begin{center}
  \begin{tikzpicture}
    \def\r{10pt}

    % --- choix de la couleur de bordure ---
    \def\linecolor{primarycolor}
    \ifstrequal{#1}{secondary}{%
      \def\linecolor{secondarycolor}%
    }{}

    % --- contenu ---
    \node[
      inner sep=10pt,
      text width=\dimexpr\textwidth-20pt\relax,
      anchor=north west
    ] (box) {\robotoCondensed\fontsize{10.5}{13}\selectfont\BODY};

    % --- bordure ---
    \begin{pgfonlayer}{background}
      \path[
        draw=\linecolor,
        line width=0.8pt
      ]
        (box.south west) --
        ($(box.south east)+(-\r,0)$)
          arc[start angle=270,end angle=360,radius=\r] --
        (box.north east) --
        ($(box.north west)+(\r,0)$)
          arc[start angle=90,end angle=180,radius=\r] --
        cycle;
    \end{pgfonlayer}

  \end{tikzpicture}
  \end{center}
}