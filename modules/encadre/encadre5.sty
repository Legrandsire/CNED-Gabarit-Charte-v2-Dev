\NewEnviron{encadre5}{%
  \begin{center}
  \begin{tikzpicture}
    \def\r{10pt} % rayon d'arrondi

    % Texte
    \node[
      inner sep=10pt,
      text width=\textwidth,
      anchor=north west
    ] (box) {\robotoCondensed\fontsize{10.5}{13}\selectfont\BODY};

    % Fond + bordure
    \begin{pgfonlayer}{background}
      \path[
        fill=background2,
      ]
        (box.south west) --
        ($(box.south east)+(-\r,0)$)
          arc[start angle=270,end angle=360,radius=\r] --
        (box.north east) --
        ($(box.north west)+(\r,0)$)
          arc[start angle=90,end angle=180,radius=\r] --
        cycle;
    \end{pgfonlayer}

  \end{tikzpicture}
  \end{center}
}

\NewEnviron{encadre53}[1][]{%
\begin{center}
  \begin{tikzpicture}
    \def\r{10pt}
    \def\rlabel{6pt}
    \def\labelheight{18pt} % hauteur réservée sous l’étiquette

    % --- BOÎTE TEXTE ---
    \node[
      inner sep=10pt,
      text width=\textwidth,
      anchor=north west
    ] (box) {%
      \begin{minipage}{\textwidth}
        \vspace*{\labelheight}
        \robotoCondensed\fontsize{10.5}{13}\selectfont\BODY
      \end{minipage}
    };

    % --- FOND BOÎTE ---
    \begin{pgfonlayer}{background}
      \path[fill=background2]
        (box.south west) --
        ($(box.south east)+(-\r,0)$)
          arc[start angle=270,end angle=360,radius=\r] --
        (box.north east) --
        ($(box.north west)+(\r,0)$)
          arc[start angle=90,end angle=180,radius=\r] --
        cycle;
    \end{pgfonlayer}

    % --- ÉTIQUETTE ---
    \node[
      anchor=north west,
      inner xsep=10pt,
      inner ysep=6pt,
      text=white
    ] (label) at (box.north west)
      {\robotoCondensed\bfseries\fontsize{11}{13}\selectfont#1};

    % --- FOND ÉTIQUETTE ---
    \begin{pgfonlayer}{background}
      \path[fill=secondarycolor]
        (label.south west) --
        ($(label.south east)+(-\rlabel,0)$)
          arc[start angle=270,end angle=360,radius=\rlabel] --
        (label.north east) --
        ($(label.north west)+(\rlabel,0)$)
          arc[start angle=90,end angle=180,radius=\rlabel] --
        cycle;
    \end{pgfonlayer}

  \end{tikzpicture}
  \end{center}
}

