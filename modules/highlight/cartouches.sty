\NewDocumentCommand{\cartouche}{ O{primary} m }{%
\begin{tikzpicture}
  \def\cartouchecolor{primarycolor}
  \ifstrequal{#1}{secondary}{%
    \def\cartouchecolor{secondarycolor}%
  }{}

  \node[
    rectangle,
    fill=none,
    text=white,
    rounded corners=0pt,
    inner xsep=10pt,
    inner ysep=6pt,
    minimum height=23pt
  ] (main) {\normalfont\bfseries\fontsize{10.5}{13}\selectfont #2};

  \begin{pgfonlayer}{background}
    \def\padx{0pt}
    \def\pady{0pt}
    \def\r{8pt}

    \coordinate (SW) at ([xshift=-\padx,yshift=-\pady]main.south west);
    \coordinate (SE) at ([xshift= \padx,yshift=-\pady]main.south east);
    \coordinate (NE) at ([xshift= \padx,yshift= \pady]main.north east);
    \coordinate (NW) at ([xshift=-\padx,yshift= \pady]main.north west);

    \path[fill=\cartouchecolor]
      (SW) --
      ([xshift=-\r]SE)
        arc (270:360:\r)
      --
      (NE) --
      ([xshift=\r]NW)
        arc (90:180:\r)
      --
      (SW) -- cycle;
  \end{pgfonlayer}
\end{tikzpicture}%
}