
\newmdenv[
  topline=false, bottomline=false, rightline=false,
  linecolor=background1, linewidth=6pt,        % barre verticale à gauche
  innerleftmargin=10pt, innerrightmargin=10pt, % espace intérieur
  skipabove=\topsep, skipbelow=\topsep,        % espaces verticaux comme quote
  leftmargin=3em, rightmargin=3em              % MARGES dans le document
]{highlightquoteprimary}

