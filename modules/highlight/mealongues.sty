\usepackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{highlightquoteprimary}{
  enhanced,
  breakable,
  colback=white,
  frame hidden,
  boxrule=0pt,
  left=14pt,
  right=10pt,
  top=6pt,
  bottom=6pt,
  before skip=\topsep,
  after skip=\topsep,
  overlay unbroken={
    \draw[background1, line width=6pt, line cap=round]
      ([xshift=4pt,yshift=-3pt]frame.north west) --
      ([xshift=4pt]frame.south west);
  },
  overlay first={
    \draw[background1, line width=6pt, line cap=round]
      ([xshift=4pt,yshift=-3pt]frame.north west) --
      ([xshift=4pt]frame.south west);
  },
  overlay middle={
    \draw[background1, line width=6pt]
      ([xshift=4pt]frame.north west) --
      ([xshift=4pt]frame.south west);
  },
  overlay last={
    \draw[background1, line width=6pt]
      ([xshift=4pt]frame.north west) --
      ([xshift=4pt]frame.south west);
  },
}

