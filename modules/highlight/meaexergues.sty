\newcommand{\tripleicon}[1]{%
  \tikz[
    baseline={([yshift=-.5ex]current bounding box.center)},
    x=1em, y=1em, line width=0.08em, #1
  ]{%
    \draw (0,0.00) -- (0.80,0.00);
    \draw (0.10,0.35) -- (0.90,0.35);
    \draw (0,0.70) -- (0.80,0.70);
  }%
}

\newcommand{\chevronicon}[1]{%
  \tikz[
    baseline={([yshift=-.5ex]current bounding box.center)},
    x=1em, y=1em, line width=0.08em, #1
  ]{%
    \draw (0.00,0.00) -- (0.28,0.28) -- (0.00,0.56);
    \draw (0.36,0.00) -- (0.64,0.28) -- (0.36,0.56);
  }%
}

\newcommand{\triple}[2]{%
  \tripleicon{#1color}\hspace{0.5em}#2%
}

\newcommand{\chevron}[2]{%
  \chevronicon{#1color}\hspace{0.5em}#2%
}