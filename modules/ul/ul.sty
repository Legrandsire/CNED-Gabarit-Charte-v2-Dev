%% Définition des puces

%% Définition des cercles
\newcommand{\primarybullet}{\tikz\fill[primarycolor] (0,0) circle (3pt);}
\newcommand{\secondarybullet}{\tikz\fill[secondarycolor] (0,0) circle (3pt);}

%% Définition des traits
\newcommand{\primarydash}{\tikz{\draw[line width=2pt,primarycolor] (0,0)--(0.2,0);}}
\newcommand{\secondarydash}{\tikz{\draw[line width=2pt,secondarycolor] (0,0)--(0.2,0);}}

%% Définition des losange vide
\newcommand{\primarydiamond}{\tikz{\draw[primarycolor, thick] (0,0) -- (0.12,0.12) -- (0,0.24) -- (-0.12,0.12) -- cycle;}}
\newcommand{\secondarydiamond}{\tikz{\draw[secondarycolor, thick] (0,0) -- (0.12,0.12) -- (0,0.24) -- (-0.12,0.12) -- cycle;}}


