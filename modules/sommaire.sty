    \node[
      anchor=west,
      align=left,
      text height=1em,
      text depth=0.25em
    ] at (0.5,0.5)
      {\bfseries \fontsize{23}{25}\selectfont
       \color{secondarycolor}\contentsname};
  \end{tikzpicture}
  \par\vspace{2em}
  \begin{tocbox}
    \@starttoc{toc}%
  \end{tocbox}%
}
