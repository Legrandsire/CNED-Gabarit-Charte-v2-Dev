\usepackage{xcolor}
\usepackage{luacolor}
\usepackage{lua-ul}

\addto\captionsfrench{\renewcommand{\contentsname}  {Sommaire} % ToC will show "Index" instead of "Content"
}



\usepackage[normalem]{ulem}        % \uline = soulignement continu multi-lignes

% --- Hook de formatage pour la numérotation des parties dans la ToC ---
\newcommand{\partnumberformat}[1]{#1}
\renewcommand{\thepart}{\protect\partnumberformat{\prefixPart \theparts \sepPart}}


% Empêche le hook de faire planter les signets PDF (hyperref)
\pdfstringdefDisableCommands{%
  \def\partnumberformat#1{#1}%
}

\renewcommand{\ULthickness}{0.8pt} % épaisseur du soulignement
% (facultatif) couleur du trait différente du texte :
\newcommand{\ulinecolor}[2]{%
  \begingroup
  \markoverwith{\textcolor{background2}{\rule[-0.35ex]{2pt}{\ULthickness}}}\ULon
  #2%
  \endgroup
}


% Box TOC: cadre fractionnable avec décor
\newtcolorbox{tocbox}[1][]{%
  enhanced, breakable, sharp corners,
  colback=white, frame hidden, boxrule=0pt,
  left=10pt, right=40pt, top=5pt, bottom=8pt,
  before skip=1em, after skip=2em,
    % --- cas 1 page (non fractionnée) ---
  overlay unbroken={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du haut : 1er segment seulement ---
  overlay first={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % -- trait du milieu
    overlay middle={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du bas : dernier segment seulement ---
  overlay last={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  #1
}

\makeatletter

\newlength{\TOCavail}
\newlength{\TOCnat}
\newlength{\TOCunder}

\newlength{\TOCnumgap}
\setlength{\TOCnumgap}{0em} % distance minimale titre <-> numéro

\newcommand{\TOCrulefill}{%
  \leavevmode
  \leaders\hrule height 1pt depth 0pt\hfill\kern0pt
}

\renewcommand{\l@part}[2]{%
  \begingroup
  \renewcommand{\partnumberformat}[1]{%
    {\textcolor{primarycolor}{%
      \robotoCondensed\mdseries\fontsize{12.5}{15}\selectfont ##1%
    }}\hspace*{-0.9em}%
  }%
  \renewcommand{\numberline}[1]{##1}%

  \vspace{0.4em}\noindent

  \pgfmathsetlengthmacro{\OvalW}{12pt}
  \pgfmathsetlengthmacro{\OvalH}{24pt}
  \pgfmathsetlengthmacro{\OvalGap}{10pt}
  \pgfmathsetlengthmacro{\ExtraX}{13pt}
  \pgfmathsetlengthmacro{\TopDrop}{-15pt}
  \pgfmathsetlengthmacro{\PnumW}{3em}
  \pgfmathsetlengthmacro{\UnderlineGap}{0.6em}
  \pgfmathsetlengthmacro{\LastUnderlineRaise}{3pt}

  \setlength{\TOCavail}{%
    \dimexpr\linewidth-\PnumW-\UnderlineGap-\OvalGap-\OvalW\relax
  }%

  \begin{tikzpicture}[baseline=(pnum.base)]

    % Titre multiligne : vrai soulignement du texte seulement
    \node[
      anchor=north west,
      inner sep=0pt,
      outer sep=0pt,
      text width=\TOCavail,
      align=left,
      execute at begin node=\raggedright
    ] (titlebox) at (0,0) {%
      {\fontsize{16}{18}\selectfont\bfseries\color{black}%
       \underLine[color=background2]{#1}}%
    };

    % Numéro de page
% Numéro de page aligné en bas de la boîte
        \node[
         inner sep=0pt,
         outer sep=0pt,
         anchor=south east,
         fill=white,
         fill opacity=1,
         text opacity=1,
         yshift=7pt % 
        ] (pnum) at (\linewidth,0 |- titlebox.south)
        {{\robotoCondensed\fontsize{11}{13}\selectfont #2}};

    % Trait horizontal final jusqu'au numéro
    \coordinate (lastlineL) at ($(titlebox.south west)+(0,\LastUnderlineRaise)$);
    \coordinate (lastlineR) at (pnum.west |- lastlineL);

    \draw[
      line width=1pt,
      background2
    ]
      ($(lastlineL)+(0,-2.5pt)$) --
      ($(lastlineR)+(-\UnderlineGap+13pt,-2.5pt)$);

    % Ovale
\path[
  fill=primarycolor,
  rounded corners=0.5em
]
  ($(titlebox.north east)+(\OvalGap+\ExtraX+5em,2pt)$)
  rectangle
  ($(titlebox.south east)+(\OvalGap+\ExtraX+\OvalW+5em,-2pt)$);

  \end{tikzpicture}%
  \par
  \endgroup
}
\def\@dotsep{2}

\renewcommand{\l@section}[2]{%
  \begingroup
    \renewcommand{\numberline}[1]{%
      {\textcolor{secondarycolor}{%
        \robotoCondensed\mdseries\fontsize{10.5}{12}\selectfont ##1%
      }}%
      \hspace{0.4em}%
    }%

    \vspace{0.5em}\noindent

    \pgfmathsetlengthmacro{\PnumW}{3em}
    \pgfmathsetlengthmacro{\NumW}{2.5em}

    \setlength{\TOCavail}{%
      \dimexpr\linewidth-\PnumW-\NumW\relax
    }%

    \begin{tikzpicture}[baseline=(titlebox.base)]
      \node[
        anchor=base west,
        inner sep=0pt,
        outer sep=0pt,
        text width=\TOCavail,
        align=left
      ] (titlebox) at (\NumW,0) {%
        \parbox{\TOCavail}{%
          \raggedright
          \bfseries
          \fontsize{13}{16}\selectfont
          #1\par
        }%
      };

      \node[
        inner sep=0pt,
        outer sep=0pt,
        anchor=base east
      ] (pnum) at (\linewidth+2.5em,0) {%
        {\robotoCondensed\fontsize{11}{13}\selectfont #2}%
      };
    \end{tikzpicture}%
    \par
  \endgroup
}

\renewcommand{\l@subsection}[2]{%
  \begingroup
    \renewcommand{\numberline}[1]{%
      {\textcolor{primarycolor}{%
        \robotoCondensed\fontsize{10}{12}\selectfont ##1%
      }}%
      \hspace{0.4em}%
    }%

    \vspace{0.5em}\noindent

    \pgfmathsetlengthmacro{\PnumW}{3em}
    \pgfmathsetlengthmacro{\NumW}{4em}
    \pgfmathsetlengthmacro{\IndentLeft}{1.5em}

    \setlength{\TOCavail}{%
      \dimexpr\linewidth-\PnumW-\NumW-\IndentLeft\relax
    }%

    \hspace*{\IndentLeft}%
    \begin{tikzpicture}[baseline=(titlebox.base)]
      \node[
        anchor=base west,
        inner sep=0pt,
        outer sep=0pt,
        text width=\TOCavail,
        align=left,
        execute at begin node=\raggedright
      ] (titlebox) at (\NumW,0) {%
        {\robotoMedium\fontsize{12}{15}\selectfont #1}%
      };

      % on compense l'indentation pour garder les numéros de page alignés
      \node[
        inner sep=0pt,
        outer sep=0pt,
        anchor=base east
      ] (pnum) at (\linewidth+\NumW-\IndentLeft,0) {%
        {\robotoCondensed\fontsize{11}{13}\selectfont #2}%
      };
    \end{tikzpicture}%
    \par
  \endgroup
}

\renewcommand{\l@subsubsection}[2]{%
  \begingroup
    \renewcommand{\numberline}[1]{%
      {\textcolor{black}{%
        \robotoCondensed\fontsize{8.5}{11}\selectfont ##1%
      }}%
      \hspace{0.4em}%
    }%

    \vspace{0.5em}\noindent

    \pgfmathsetlengthmacro{\PnumW}{3em}
    \pgfmathsetlengthmacro{\NumW}{5.2em}
    \pgfmathsetlengthmacro{\IndentLeft}{3em}

    \setlength{\TOCavail}{%
      \dimexpr\linewidth-\PnumW-\NumW-\IndentLeft\relax
    }%

    \hspace*{\IndentLeft}%
    \begin{tikzpicture}[baseline=(titlebox.base)]
      \node[
        anchor=base west,
        inner sep=0pt,
        outer sep=0pt,
        text width=\TOCavail,
        align=left,
        execute at begin node=\raggedright
      ] (titlebox) at (\NumW,0) {%
        {\normalfont\fontsize{11}{13}\selectfont #1}%
      };

      \node[
        inner sep=0pt,
        outer sep=0pt,
        anchor=base east
      ] (pnum) at (\linewidth+\NumW-\IndentLeft,0) {%
        {\robotoCondensed\fontsize{11}{13}\selectfont #2}%
      };
    \end{tikzpicture}%
    \par
  \endgroup
}
