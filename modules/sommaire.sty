\addto\captionsfrench{\renewcommand{\contentsname}  {Sommaire} % ToC will show "Index" instead of "Content"
}

\usepackage[normalem]{ulem}        % \uline = soulignement continu multi-lignes

% --- Hook de formatage pour la numérotation des parties dans la ToC ---
\newcommand{\partnumberformat}[1]{#1}
\renewcommand{\thepart}{\protect\partnumberformat{\prefixPart \theparts \sepPart}}

% Empêche le hook de faire planter les signets PDF (hyperref)
\pdfstringdefDisableCommands{%
  \def\partnumberformat#1{#1}%
}

\renewcommand{\ULthickness}{0.8pt} % épaisseur du soulignement
% (facultatif) couleur du trait différente du texte :
\newcommand{\ulinecolor}[2]{%
  \begingroup
  \markoverwith{\textcolor{background2}{\rule[-0.35ex]{2pt}{\ULthickness}}}\ULon
  #2%
  \endgroup
}


% Box TOC: cadre fractionnable avec décor
\newtcolorbox{tocbox}[1][]{%
  enhanced, breakable, sharp corners,
  colback=white, frame hidden, boxrule=0pt,
  left=10pt, right=40pt, top=0pt, bottom=8pt,
  before skip=1em, after skip=2em,
    % --- cas 1 page (non fractionnée) ---
  overlay unbroken={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du haut : 1er segment seulement ---
  overlay first={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % -- trait du milieu
    overlay middle={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du bas : dernier segment seulement ---
  overlay last={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  #1
}

\makeatletter

\newlength{\TOCavail}
\newlength{\TOCnat}
\newlength{\TOCunder}

\renewcommand{\l@part}[2]{%
  \begingroup
  % --- Activation du style sur le numéro de la partie ---
  \renewcommand{\partnumberformat}[1]{{\textcolor{primarycolor}{\robotoCondensed\mdseries\fontsize{12.5}{15}\selectfont ##1}}\hspace*{-0.9em}}%
  
  % --- Sécurité : on neutralise \numberline au cas où LaTeX l'ajoute ---
  \renewcommand{\numberline}[1]{##1}%

  \vspace{-5pt}\noindent
  % --- dimensions ---
  \pgfmathsetlengthmacro{\OvalW}{12pt}
  \pgfmathsetlengthmacro{\OvalH}{24pt}
  \pgfmathsetlengthmacro{\OvalGap}{10pt} % espace entre numéro et ovale
  \pgfmathsetlengthmacro{\TopDrop}{-15pt}
  \pgfmathsetlengthmacro{\ExtraX}{13pt}
  \pgfmathsetlengthmacro{\PnumW}{3em}    % largeur réservée au numéro de page

  % largeur dispo pour le titre (on réserve : num page + gap + ovale)
  \setlength{\TOCavail}{\dimexpr\linewidth-\PnumW-\OvalGap-\OvalW\relax}

  \begin{tikzpicture}[baseline=(title.base)]
  % coordonnées du titre, sans encore l'afficher
  \node[
    inner sep=0pt,
    outer sep=0pt,
    anchor=west,
    text width=\TOCavail
  ] (titlebox) {\phantom{\fontsize{16}{18}\selectfont\bfseries #1}};

  % trait derrière
  \draw[line width=1pt, background2] %épaisseur du trait qui souligne
    ($(titlebox.base west)+(0,-6pt)$) -- ++(\linewidth,0); %Distance du trait

  % titre affiché par-dessus
  \node[
    inner sep=0pt,
    outer sep=0pt,
    anchor=west,
    text=black,
    text width=\TOCavail
  ] (title) {\fontsize{16}{18}\selectfont\bfseries #1};

    % --- Numéro de page (par-dessus le trait) ---
    \node[
      inner sep=0pt,
      anchor=east,
      fill=white, % masque le trait sous le texte (optionnel)
      fill opacity=1,
      text opacity=1
    ] (pnum) at (\linewidth,0)
      {{\robotoCondensed \fontsize{11}{13}\selectfont #2}};

    % --- Ovale après le numéro ---
    \path[
      fill=primarycolor,
      rounded corners=0.5em
    ]
      ($ (pnum.east) + (\OvalGap+\ExtraX, -\TopDrop) $)
      rectangle
      ($ (pnum.east) + (\OvalGap+\ExtraX+\OvalW, -\TopDrop-\OvalH) $);
  \end{tikzpicture}%
  \par
  \endgroup
}
\def\@dotsep{2}

\renewcommand{\l@section}[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode
      \renewcommand{\numberline}[1]{{\textcolor{secondarycolor}{{\robotoCondensed\mdseries \fontsize{10,5}{12}\selectfont ##1}}}\hspace{0.2em}}%
      {\bfseries\fontsize{13}{16}\selectfont #1}%
      \hfill
      \nobreak\hb@xt@2em{\hfil {\robotoCondensed\fontsize{11}{13}\selectfont #2}}\par
    \endgroup
  \fi}

\renewcommand{\l@subsection}[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode
      \hskip 1.4em
      \renewcommand{\numberline}[1]{\makebox[2em][l]{\textcolor{primarycolor}{{\robotoCondensed \fontsize{10}{12}\selectfont##1}}}\hspace{0.1em}}%
      {\robotoMedium \fontsize{12}{15}\selectfont #1}%
      \hfill
      \nobreak\hb@xt@2em{\hfil{\robotoCondensed\fontsize{11}{13}\selectfont ~#2}}\par
    \endgroup
  \fi}

\renewcommand{\l@subsubsection}[2]{%
  \ifnum \c@tocdepth >\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode
      \hskip 3.6em
      \renewcommand{\numberline}[1]{\makebox[1em][l]{\textcolor{black}{{\robotoCondensed \fontsize{8,5}{11}\selectfont##1}}}\hspace{0.1em}}%
      {\normalfont \fontsize{11}{13}\selectfont #1}%
      \hfill
      \nobreak\hb@xt@2em{\hfil{\robotoCondensed\fontsize{11}{13}\selectfont ~#2}}\par
    \endgroup
  \fi}
