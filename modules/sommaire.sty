\usepackage[normalem]{ulem}        % \uline = soulignement continu multi-lignes

% --- Hook de formatage pour la numérotation des parties dans la ToC ---
\newcommand{\partnumberformat}[1]{#1}
\renewcommand{\thepart}{\protect\partnumberformat{\prefixPart \theparts \sepPart}}

% Empêche le hook de faire planter les signets PDF (hyperref)
\pdfstringdefDisableCommands{%
  \def\partnumberformat#1{#1}%
}

\renewcommand{\ULthickness}{0.8pt} % épaisseur du soulignement
% (facultatif) couleur du trait différente du texte :
\newcommand{\ulinecolor}[2]{%
  \begingroup
  \markoverwith{\textcolor{background2}{\rule[-0.35ex]{2pt}{\ULthickness}}}\ULon
  #2%
  \endgroup
}


% Box TOC: cadre fractionnable avec décor
\newtcolorbox{tocbox}[1][]{%
  enhanced, breakable, sharp corners,
  colback=white, frame hidden, boxrule=0pt,
  left=10pt, right=40pt, top=5pt, bottom=8pt,
  before skip=1em, after skip=2em,
    % --- cas 1 page (non fractionnée) ---
  overlay unbroken={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du haut : 1er segment seulement ---
  overlay first={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % -- trait du milieu
    overlay middle={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
    \pgfmathsetlengthmacro{\LW}{5pt}
    % contour 
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  % --- trait du bas : dernier segment seulement ---
  overlay last={
    \pgfmathsetlengthmacro{\dy}{0.35pt}
\draw[
  line width=0.8pt,
  primarycolor,
  rounded corners=4pt % ← ajuste la valeur
]
  ([xshift=15pt]frame.south west) --
  (frame.south west) --
  (frame.north west) --
  ([xshift=15pt]frame.north west);
  },
  #1
}

\makeatletter

\newlength{\TOCavail}
\newlength{\TOCnat}
\newlength{\TOCunder}

\newlength{\TOCnumgap}
\setlength{\TOCnumgap}{0em} % distance minimale titre <-> numéro

\newcommand{\TOCrulefill}{%
  \leavevmode
  \leaders\hrule height 1pt depth 0pt\hfill\kern0pt
}

\renewcommand{\l@part}[2]{%
  \begingroup
  \renewcommand{\partnumberformat}[1]{%
    {\textcolor{primarycolor}{%
      \robotoCondensed\mdseries\fontsize{12.5}{15}\selectfont ##1%
    }}\hspace*{-0.9em}%
  }%
  \renewcommand{\numberline}[1]{##1}%

  \vspace{0.4em}\noindent

  \pgfmathsetlengthmacro{\OvalW}{12pt}
  \pgfmathsetlengthmacro{\OvalH}{24pt}
  \pgfmathsetlengthmacro{\OvalGap}{10pt}
  \pgfmathsetlengthmacro{\ExtraX}{13pt}
  \pgfmathsetlengthmacro{\TopDrop}{-15pt}
  \pgfmathsetlengthmacro{\PnumW}{3em}
  \pgfmathsetlengthmacro{\UnderlineGap}{0.6em}
  \pgfmathsetlengthmacro{\LastUnderlineRaise}{3pt}

  \setlength{\TOCavail}{%
    \dimexpr\linewidth-\PnumW-\UnderlineGap-\OvalGap-\OvalW\relax
  }%

  \begin{tikzpicture}[baseline=(pnum.base)]

    % Titre multiligne : vrai soulignement du texte seulement
    \node[
      anchor=north west,
      inner sep=0pt,
      outer sep=0pt,
      text width=\TOCavail,
      align=left,
      execute at begin node=\raggedright
    ] (titlebox) at (0,0) {%
      {\fontsize{16}{18}\selectfont\bfseries\color{black}%
       \underLine[color=background2]{#1}}%
    };

    % Numéro de page
    \node[
      inner sep=0pt,
      outer sep=0pt,
      anchor=base east,
      fill=white,
      fill opacity=1,
      text opacity=1
    ] (pnum) at (\linewidth,-13pt)
      {{\robotoCondensed\fontsize{11}{13}\selectfont #2}};

    % Trait horizontal final jusqu'au numéro
    \coordinate (lastlineL) at ($(titlebox.south west)+(0,\LastUnderlineRaise)$);
    \coordinate (lastlineR) at (pnum.west |- lastlineL);

    \draw[
      line width=1pt,
      background2
    ]
      ($(lastlineL)+(0,-2.5pt)$) --
      ($(lastlineR)+(-\UnderlineGap+13pt,-2.5pt)$);

    % Ovale
    \path[
      fill=primarycolor,
      rounded corners=0.5em
    ]
      ($(pnum.east)+(\OvalGap+\ExtraX,-\TopDrop)$)
      rectangle
      ($(pnum.east)+(\OvalGap+\ExtraX+\OvalW,-\TopDrop-\OvalH)$);

  \end{tikzpicture}%
  \par
  \endgroup
}
\def\@dotsep{2}

\renewcommand{\l@section}[2]{%
  \ifnum\c@tocdepth>\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \setlength{\@tempdima}{0.0em}% largeur exacte réservée au numéro
      \parindent\z@
      \rightskip\@pnumwidth
      \parfillskip-\@pnumwidth
      \leftskip=0pt
      \parindent=0pt
      \leavevmode
      \llap{%
         \textcolor{secondarycolor}{%
          \robotoCondensed\mdseries\fontsize{10.5}{12}\selectfont
          \thesection
         }%
      \hskip0.4em % espace après numéro
        }%
      {\RaggedRight
        \bfseries\fontsize{13}{16}\selectfont
        #1\par
      }%
      \nobreak\hfill
      \nobreak\hb@xt@\@pnumwidth{\hss{\robotoCondensed\fontsize{11}{13}\selectfont \hspace{1em}#2}}%
      \par
    \endgroup
  \fi
}

\renewcommand{\l@subsection}[2]{%
  \ifnum\c@tocdepth>\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \setlength{\@tempdima}{4em}
      \parindent\z@
      \rightskip\@pnumwidth
      \parfillskip-\@pnumwidth
      \leftskip\@tempdima
      \parindent-\leftskip
      \leavevmode
      \llap{%
        \textcolor{primarycolor}{%
          \robotoCondensed\fontsize{10}{12}\selectfont
          \makebox[\@tempdima][l]{\thesubsection}%
        }%
        \hskip0.2em
      }%
      {\robotoMedium\fontsize{12}{15}\selectfont #1}%
      \nobreak\hfill
      \nobreak\hb@xt@\@pnumwidth{\hss{\robotoCondensed\fontsize{11}{13}\selectfont #2}}%
      \par
    \endgroup
  \fi
}
\renewcommand{\l@subsubsection}[2]{%
  \ifnum\c@tocdepth>\z@
    \addpenalty{\@secpenalty}%
    \vskip 0.5em \@plus\p@
    \begingroup
      \setlength{\@tempdima}{5.2em}
      \parindent\z@
      \rightskip\@pnumwidth
      \parfillskip-\@pnumwidth
      \leftskip\@tempdima
      \advance\leftskip by 0.2em
      \parindent-\leftskip
      \leavevmode
      \llap{%
        \textcolor{black}{%
          \robotoCondensed\fontsize{8.5}{11}\selectfont
          \makebox[\@tempdima][l]{\thesubsubsection}%
        }%
        \hskip0.2em
      }%
      {\normalfont\fontsize{11}{13}\selectfont #1}%
      \nobreak\hfill
      \nobreak\hb@xt@\@pnumwidth{\hss{\robotoCondensed\fontsize{11}{13}\selectfont #2}}%
      \par
    \endgroup
  \fi
}
