% --- Liste numérotée unifiée corrigée --------------------------------------
\newlist{olbase}{enumerate}{4} % <--- CORRECTION : On autorise jusqu'à 4 niveaux

\NewDocumentEnvironment{oList}{ O{arabic} O{primary} }
{%
  % Couleur : primary | secondary | autre couleur xcolor
  \setresolvedcolor{#2}%

  % Valeurs par défaut utilisant l'étoile (*) d'enumitem
  \def\oltypelabel{\arabic*}%
  \def\ollabelsep{0.6em}%

  % Type : arabic | Alph | Roman
  \ifstrequal{#1}{arabic}{%
    \def\oltypelabel{\arabic*}%
  }{}%

  \ifstrequal{#1}{Alph}{%
    \def\oltypelabel{\Alph*}%
  }{}%

  \ifstrequal{#1}{alph}{%
    \def\oltypelabel{\alph*}%
  }{}%

  \ifstrequal{#1}{Roman}{%
    \def\oltypelabel{\Roman*}%
    \def\ollabelsep{0.3em}%
  }{}%

  \begin{olbase}[
    label={\textcolor{\resolvedcolor}{\bfseries\oltypelabel.}},
    labelsep=\ollabelsep,
    leftmargin=*,
    itemsep=.25\baselineskip
  ]%
}
{%
  \end{olbase}%
}