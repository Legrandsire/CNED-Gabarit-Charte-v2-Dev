% prérequis
\usepackage{xcolor}
\usepackage{soul}
\usepackage{titlesec} % SANS option [explicit]

\setul{2pt}{0.25ex}
\newcommand{\Underlined}[1]{%
  {\begingroup \setulcolor{background2}\ul{#1}\endgroup}%
}

% création du niveau
\titleclass{\subsubsubsection}{straight}[\subsubsection]
\newcounter{subsubsubsection}[subsubsection]
\renewcommand\thesubsubsubsection{\alph{subsubsubsection}.}

\makeatletter
\expandafter\def\csname toclevel@subsubsubsection\endcsname{5}
\makeatother

% autoriser la numérotation/ToC jusqu'à ce niveau
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}% autoriser la numérotation/ToC 

% pour l'accessibilité :
\newcommand{\HfiveStart}{\tagstructbegin{tag=H5}\tagmcbegin{tag=Span}}
\newcommand{\HfiveEnd}{\tagmcend\tagstructend}


% format (sans explicit)
\titleformat{\subsubsubsection}[block]
  {\robotoCondensed\bfseries\fontsize{15}{18}\selectfont\RaggedRight}
  {\thesubsubsubsection}
  {0.8em}
  {\HfiveStart\phantomsection\color{primarycolor}\Underlined\HfiveEnd} % pas de wrap du texte ici, on le fera à l'appel
  []

\titlespacing*{\subsubsubsection}{0pt}{2ex plus .5ex minus .2ex}{0.8ex}