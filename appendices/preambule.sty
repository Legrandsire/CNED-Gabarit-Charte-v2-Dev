% Repartiteur de typographie des numeros de titres : chaque module peut
% definir \@seccntformat@<nom> ; a defaut, comportement standard de la
% classe. (Le balisage du numero — structure « section-number » — est
% pose par le module « sec » du noyau autour de ce format, il n'est pas
% affecte.)
\makeatletter
\renewcommand{\@seccntformat}[1]{%
  \ifcsname @seccntformat@#1\endcsname
    \csname @seccntformat@#1\endcsname
  \else
    \csname the#1\endcsname\quad
  \fi}
\makeatother

% Titres jamais orphelins en bas de page (applique ici, apres les
% redefinitions des modules de titres). Le titre 1 (\section) gere
% lui-meme son saut de page / sa garantie d'espace.
\preto{\subsection}{\Needspace{5\baselineskip}}
\preto{\subsubsection}{\Needspace{5\baselineskip}}

% --- Faire apparaître les \subsection* et \subsubsection* dans le sommaire ---
% Implémentation xparse (\RenewDocumentCommand) : l'ancienne version à base
% de \@ifstar bouclait à l'infini sur \subsection* (« TeX capacity
% exceeded ») — amsgen (amsmath) redéfinit \@ifstar avec une macro
% partagée \reserved@a, et la commande expansible produite par
% \renewcommand s'auto-expansait dans les contextes de pure expansion
% (marques de section, hyperref). Les commandes xparse sont protégées et
% analysent l'étoile sans \@ifstar : ne pas revenir en arrière.
\let\oldsubsection\subsection
\RenewDocumentCommand{\subsection}{s o m}{%
  \IfBooleanTF{#1}
    {\oldsubsection*{#3}% garde exactement la mise en forme visuelle
     \phantomsection
     \addcontentsline{toc}{subsection}{\protect\numberline{}#3}}% entrée ToC sans numéro
    {\IfNoValueTF{#2}{\oldsubsection{#3}}{\oldsubsection[#2]{#3}}}%
}

\let\oldsubsubsection\subsubsection
\RenewDocumentCommand{\subsubsection}{s o m}{%
  \IfBooleanTF{#1}
    {\oldsubsubsection*{#3}% garde le style visuel
     \phantomsection
     \addcontentsline{toc}{subsubsection}{\protect\numberline{}#3}}%
    {\IfNoValueTF{#2}{\oldsubsubsection{#3}}{\oldsubsubsection[#2]{#3}}}%
}

\let\oldparagraph\paragraph
\RenewDocumentCommand{\paragraph}{s o m}{%
  \IfBooleanTF{#1}
    {\oldparagraph*{#3}% garde le style visuel
     \phantomsection
     \addcontentsline{toc}{paragraph}{\protect\numberline{}#3}}%
    {\IfNoValueTF{#2}{\oldparagraph{#3}}{\oldparagraph[#2]{#3}}}%
}

