%==================================================================
% Paramétrage de l'automatisation des crédits en fin de document
% (liste unique : images, tableaux, et tout contenu à sourcer)
%==================================================================

% 1. On initialise une macro vide pour stocker la liste des crédits
\newcommand{\mescredits}{}

% 2. On crée un compteur pour générer des identifiants (labels) uniques
\newcounter{creditcount}

% 3. On crée une commande intermédiaire pour l'ajout
% #1 : Numéro du label, #2 : Désignation, #3 : Source
\newcommand{\addcredithelper}[3]{%
  \gappto\mescredits{\item \mdseries{#2} (p. \pageref{credit:#1}) : #3}%
}

% 4. La commande principale : \credits{désignation}{source}
% Affiche « Source : ... » sur place et alimente la page de crédits.
\newcommand{\credits}[2]{%
  \stepcounter{creditcount}% Incrémente le compteur
  \label{credit:\arabic{creditcount}}% Place un label unique sur la page actuelle
  % Affichage direct sous le contenu crédité
  {\footnotesize Source : #2}%
  % On sauvegarde la valeur actuelle du compteur pour forcer son évaluation immédiate
  \edef\currentcredit{\arabic{creditcount}}%
  % Enregistrement dans la liste avec l'identifiant figé
  \expandafter\addcredithelper\expandafter{\currentcredit}{#1}{#2}%
}

% 5. Alias conservés pour les documents existants
\newcommand{\sourceimage}{\credits}
\newcommand{\sourcetableau}{\credits}