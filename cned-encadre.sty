% ==============================================================================
% PACKAGE : cned-encadre.sty
% DESCRIPTION : Définition des styles de blocs encadrés selon la charte CNED.
% REQUIS : Ce package suppose que la couleur 'primarycolor' et la police
%          '\DinOTBold' sont déjà définies dans le projet.
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cned-encadre}[2026/01/29 v1.0 Styles d'encadrés CNED]

% --- Chargement des dépendances nécessaires ---
% tcolorbox : le moteur pour créer les boîtes
% enhanced : permet des styles avancés
% breakable : permet à la boîte de se couper sur plusieurs pages
\RequirePackage[enhanced, breakable]{tcolorbox}
% fontawesome5 : pour l'icône par défaut (le crayon)
% Vous pouvez commenter cette ligne si vous utilisez une autre méthode pour les icônes.
\RequirePackage{fontawesome5}
% xcolor : pour la gestion des couleurs (normalement déjà chargé, mais sécurité)
\RequirePackage{xcolor}

% ==============================================================================
% Style : Bloc encadré 1 (Titre sur fond coloré avec icône)
% ==============================================================================
% Utilisation :
% \begin{cnedBoxOne}{Titre de l'encadré}
%    Contenu...
% \end{cnedBoxOne}
%
% Optionnel : changer l'icône
% \begin{cnedBoxOne}[\faLightbulb]{Titre avec ampoule} ...

\newtcolorbox{cnedBoxOne}[2][\faPen]{% Argument optionnel [#1]=icône, Argument obligatoire {#2}=titre
  % --- Style global ---
  enhanced,             % Active les fonctionnalités avancées
  breakable,            % La boîte peut se couper entre les pages
  parbox=false,         % Meilleure gestion des paragraphes à l'intérieur

  % --- Couleurs ---
  colframe=primarycolor,     % Couleur de la bordure extérieure
  colbacktitle=primarycolor, % Couleur de fond du titre (identique à la bordure)
  coltitle=white,            % Couleur du texte du titre
  colback=white,             % Couleur de fond du contenu principal

  % --- Géométrie et Bordures ---
  boxrule=1pt,          % Épaisseur du trait de contour
  arc=0mm,              % Pas d'arrondis aux coins intérieurs
  outer arc=0mm,        % Pas d'arrondis aux coins extérieurs
  leftrule=1pt, rightrule=1pt, bottomrule=1pt, toprule=1pt, % Uniformisation

  % --- Espacements (Padding) ---
  % Espacement interne autour du contenu
  boxsep=5pt,
  left=4pt, right=4pt, top=5pt, bottom=5pt,
  % Espacement interne du titre
  toptitle=4pt, bottomtitle=4pt,

  % --- Typographie du Titre ---
  % On applique la police Din Bold, on met en majuscules
  fonttitle=\DinOTBold\selectfont\MakeUppercase,

  % --- Construction du Titre ---
  % Insère l'icône (#1) suivie d'un espace, puis le titre (#2)
  title={#1\hspace{0.75em}#2},
}

\endinput